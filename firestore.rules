rules_version = '2';

/**
 * ============================================================================
 * TROCO — RÈGLES DE SÉCURITÉ FIRESTORE ZERO-TRUST
 * ============================================================================
 * 
 * Instructions de déploiement :
 * ----------------------------
 * 1. Assurez-vous d'être authentifié avec la CLI Firebase :
 *    npx firebase-tools login
 * 
 * 2. Vérifiez le projet actif :
 *    npx firebase-tools use --add (ou npx firebase-tools projects:list)
 * 
 * 3. Déployez ces règles de sécurité :
 *    npx firebase-tools deploy --only firestore:rules
 * 
 * ============================================================================
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions d'authentification et d'administration
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Vérification de l'administrateur (via Custom Claims Firebase Auth ou UID Master vérifié)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.uid == 'MASTER_ADMIN_TROCO_UID_KEY' ||
        request.auth.uid == 'ADMIN_RECOVERY_UID_2026'
      );
    }

    // --- COLLECTION USERS ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Création initiale autorisée pour le profil connecté
      allow create: if isOwner(userId);

      // Mise à jour : l'utilisateur peut modifier ses données personnelles,
      // MAIS les champs sensibles comme `trocoTokens`, `euroBalance`, `kycVerified`, `isAdmin`
      // ne peuvent pas être modifiés unilatéralement par le client si l'utilisateur n'est pas Admin.
      allow update: if isOwner(userId) && (
        isAdmin() || (
          // Empêche la manipulation directe du solde de jetons / euros sans passer par une transaction sécurisée
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['trocoTokens', 'euroBalance', 'isAdmin', 'role', 'kycVerified'])
        )
      ) || isAdmin();

      // Suppression de compte strictement réservée à l'administrateur ou au propriétaire
      allow delete: if isOwner(userId) || isAdmin();

      // Sous-collections de l'utilisateur (historique, préférences, notifications)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- COLLECTION LISTINGS (ANNONCES) ---
    match /listings/{listingId} {
      allow read: if true; // Feed accessible pour le FCP/découverte
      allow create: if isAuthenticated() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // --- COLLECTION CHATS & MESSAGES ---
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          request.resource.data.senderUid == request.auth.uid ||
          request.resource.data.senderId == request.auth.uid ||
          request.resource.data.sender == 'me' ||
          request.resource.data.sender == request.auth.uid
        );
        allow update, delete: if isAuthenticated() && (
          resource.data.senderUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // --- COLLECTION TRANSACTIONS & SÉQUESTRE ---
    // Verrouillage Zero-Trust : Aucune création/modification arbitraire sans auth stricte
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      
      // Création autorisée si l'initiateur est l'acheteur/émetteur de la transaction
      allow create: if isAuthenticated() && (
        request.resource.data.buyerUid == request.auth.uid ||
        request.resource.data.senderUid == request.auth.uid ||
        isAdmin()
      );

      // Modification interdite aux clients normaux une fois scellée sauf admin
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- COLLECTION GLOBAL_CONTENT & CONFIG (GOD MODE) ---
    match /global_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- COLLECTION WHITEBOARDS & COLLABORATIVE SUITE ---
    match /whiteboards/{boardId} {
      allow read, write: if isAuthenticated();
    }

    // --- COLLECTION LIVE_AUDIO_ROOMS ---
    match /live_audio_rooms/{roomId} {
      allow read, write: if isAuthenticated();
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // --- COLLECTION AUDIT_LOGS ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immuable
    }

    // --- COLLECTION PRESENCE ---
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }
  }
}
