rules_version = '2';

/**
 * ============================================================================
 * 🛡️ TROCO — RÈGLES DE SÉCURITÉ FIRESTORE ZERO-TRUST (DENY-BY-DEFAULT)
 * ============================================================================
 * Architecture : Marketplace internationale de troc & entraide de compétences.
 * Standard de sécurité : Fintech régulée, conformité ISO 27001 & RGPD.
 *
 * Principes fondamentaux :
 * 1. Deny-by-default : Tout accès non expressément autorisé est interdit.
 * 2. Moindre privilège : Chaque utilisateur n'accède qu'aux données strictement requises.
 * 3. Intégrité financière absolue : Soldes, transactions et statuts modifiables
 *    uniquement via l'Admin SDK serveur (Cloud Functions / Firebase Admin).
 * 4. Autorité cryptographique : Rôles basés sur les Custom Claims signés (admin: true)
 *    et interdiction d'utiliser request.auth.token.email (falsifiable).
 * ============================================================================
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // 🧰 FONCTIONS HELPER DE SÉCURITÉ RÉUTILISABLES
    // ========================================================================

    /**
     * Vérifie si la requête émane d'un utilisateur authentifié auprès de Firebase Auth.
     */
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    /**
     * Vérifie si l'utilisateur authentifié est le propriétaire de la ressource ciblée.
     */
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    /**
     * Vérifie si l'utilisateur possède le custom claim administrateur signé.
     * Interdiction d'utiliser le token email qui peut être altéré ou non vérifié.
     */
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    /**
     * Vérifie si l'utilisateur authentifié n'est pas sous le coup d'un bannissement.
     * Si le document n'existe pas encore (création de compte) ou isBanned != true, l'accès est valide.
     */
    function isNotBanned() {
      return isAuthenticated() &&
        !(exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned == true);
    }

    // ========================================================================
    // ⛔ VERROUILLAGE PAR DÉFAUT (ZERO-TRUST DENY ALL)
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================================
    // 👤 COLLECTION USERS (PROFILS PRIVÉS & NOTIFICATIONS)
    // ========================================================================
    match /users/{uid} {
      // Lecture : propriétaire du profil ou administrateur uniquement
      allow read: if isOwner(uid) || isAdmin();

      // Création : propriétaire uniquement.
      // Interdiction FORMELLE d'initialiser les champs critiques et financiers côté client.
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny([
          'euroBalance', 'trocoTokens', 'dealsCompleted', 'kycVerified',
          'isBanned', 'isShadowBanned', 'role', 'subscriptionPlan', 'cguAcceptedAt'
        ]);

      // Mise à jour : propriétaire non banni uniquement.
      // Protection stricte contre l'altération des soldes, réputation, bans et abonnements.
      allow update: if isOwner(uid) && isNotBanned()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'euroBalance', 'trocoTokens', 'dealsCompleted', 'kycVerified',
          'isBanned', 'isShadowBanned', 'role', 'subscriptionPlan', 'cguAcceptedAt'
        ]);

      // Suppression directe interdite au client (traitée par Cloud Functions RGPD)
      allow delete: if false;

      // Sous-collection interne : Notifications
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(uid) || isAdmin();
        allow create: if isAuthenticated();
      }
    }

    // ========================================================================
    // 🌐 COLLECTION USERS_PUBLIC (PROFILS MINIMALISTES CONFORMES RGPD)
    // ========================================================================
    match /users_public/{uid} {
      // Lecture : tout utilisateur authentifié (ou feed)
      allow read: if isAuthenticated();
      // Écriture : interdite à tous les clients (géré exclusivement par Cloud Functions)
      allow write: if false;
    }

    // ========================================================================
    // 📢 COLLECTION LISTINGS (ANNONCES DE SERVICES & BIENS)
    // ========================================================================
    match /listings/{listingId} {
      // Lecture : publique si annonce active, sans statut défini (annonces publiques), créateur ou admin
      allow read: if (resource.data.status == 'active')
        || !('status' in resource.data)
        || (isAuthenticated() && request.auth.uid == resource.data.authorUid)
        || isAdmin();

      // Création : utilisateur authentifié non banni qui s'assigne comme auteur
      allow create: if isAuthenticated() && isNotBanned()
        && request.resource.data.authorUid == request.auth.uid;

      // Modification : auteur non banni sans toucher aux attributs protégés (boosts/modération), ou admin
      allow update: if (
        isAuthenticated()
        && request.auth.uid == resource.data.authorUid
        && isNotBanned()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isBoosted', 'isHidden', 'firestoreId'
        ])
      ) || isAdmin();

      // Suppression : auteur de l'annonce ou administrateur
      allow delete: if (isAuthenticated() && request.auth.uid == resource.data.authorUid) || isAdmin();
    }

    // ========================================================================
    // 💬 COLLECTION GLOBAL_CHAT (MESSAGERIE INSTANTANÉE COMMUNAUTAIRE)
    // ========================================================================
    match /global_chat/{msgId} {
      // Lecture publique du chat en direct
      allow read: if true;

      // Création : membre authentifié non banni
      allow create: if isAuthenticated() && isNotBanned();

      // Modification / Suppression : auteur du message ou administrateur
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
    }

    // ========================================================================
    // 📢 COLLECTION COMMUNITY_MESSAGES (COMMUNAUTÉ)
    // ========================================================================
    match /community_messages/{msgId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
    }

    // ========================================================================
    // 🟢 COLLECTION PRESENCE (STATUT EN LIGNE / HORS LIGNE)
    // ========================================================================
    match /presence/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // ========================================================================
    // 💬 COLLECTION CHATS (CONVERSATIONS ET DISCUSSIONS PRIVÉES)
    // ========================================================================
    match /chats/{chatId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        (resource.data.participantUids is list && request.auth.uid in resource.data.participantUids) ||
        isAdmin()
      );

      allow create: if request.auth != null && (
        request.auth.uid in request.resource.data.participants ||
        (request.resource.data.participantUids is list && request.auth.uid in request.resource.data.participantUids)
      );

      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        (resource.data.participantUids is list && request.auth.uid in resource.data.participantUids) ||
        isAdmin()
      );

      allow delete: if false;

      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids is list &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids) ||
          isAdmin()
        );
      }

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids is list &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids) ||
          isAdmin()
        );
      }
    }

    // ========================================================================
    // 💳 COLLECTION TRANSACTIONS (REGISTRE FINANCIER & SÉQUESTRE ESCROW)
    // ========================================================================
    match /transactions/{txId} {
      // Lecture : parties prenantes de la transaction ou administrateur
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || resource.data.partnerUid == request.auth.uid
        || resource.data.buyerUid == request.auth.uid
        || resource.data.sellerUid == request.auth.uid
        || isAdmin()
      );

      // Écriture : réservée au serveur (ou transaction client initialisée)
      allow create: if isAuthenticated() && isNotBanned()
        && (request.resource.data.userId == request.auth.uid || request.resource.data.buyerUid == request.auth.uid);
      allow update, delete: if false;
    }

    // ========================================================================
    // 🚨 COLLECTION REPORTS (SIGNALEMENTS DE SÉCURITÉ & MODÉRATION)
    // ========================================================================
    match /reports/{reportId} {
      // Lecture : réservée strictement aux administrateurs (protection des lanceurs d'alerte)
      allow read: if isAdmin();

      // Création : tout membre authentifié et non banni peut signaler un abus
      allow create: if isAuthenticated() && isNotBanned()
        && request.resource.data.reporterUid == request.auth.uid;

      // Traitement et suppression : administrateurs uniquement
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // 🎁 COLLECTION CAMPAIGNS (CAMPAGNES BONUS & PROMOTIONS)
    // ========================================================================
    match /campaigns/{campaignId} {
      // Lecture : utilisateurs authentifiés pour les campagnes actives
      allow read: if isAuthenticated() && resource.data.active == true;

      // Écriture : administrateurs uniquement
      allow write: if isAdmin();
    }

    // ========================================================================
    // 📞 COLLECTION CALLS (SIGNALING WEBRTC & CANDIDATS ICE)
    // ========================================================================
    match /calls/{callId} {
      allow read, write: if isAuthenticated();
      match /{subcollection}/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ========================================================================
    // 📰 COLLECTION GLOBAL_CONTENT (CMS & BANNIÈRES)
    // ========================================================================
    match /global_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================================
    // 🎨 ESPACES COLLABORATIFS & WHITEBOARDS
    // ========================================================================
    match /whiteboard_rooms/{roomId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /project_whiteboards/{boardId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /project_shared_notes/{noteId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /workspaces/{workspaceId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /chatThreads/{threadId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
