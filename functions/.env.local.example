# Configuration d'environnement locale pour Firebase Cloud Functions (Troco)
# Copier sous .env.local pour le développement local

# Fournisseur de paiement ('mock' pour dev/test, 'stripe' pour prod)
PAYMENT_PROVIDER=mock

# Clé secrète Stripe (nécessaire si PAYMENT_PROVIDER=stripe)
# STRIPE_SECRET_KEY=sk_test_...

# Clé API SendGrid pour notifications RGPD / transactionnelles
# SENDGRID_API_KEY=SG...
